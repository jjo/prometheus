eval instant at 4s sum_over_time(metric[1001ms])
  {} 1001

eval instant at 4s sum_over_time(metric[1002ms])
  {} 1002

eval instant at 4s sum_over_time(metric[1003ms])
  {} 1003

eval instant at 4s sum_over_time(metric[2000ms])
  {} 2000

eval instant at 4s sum_over_time(metric[2001ms])
  {} 2001

eval instant at 4s sum_over_time(metric[2002ms])
  {} 2002

eval instant at 4s sum_over_time(metric[2003ms])
  {} 2003

eval instant at 4s sum_over_time(metric[3000ms])
  {} 3000

eval instant at 4s sum_over_time(metric[3001ms])
  {} 3001

eval instant at 4s sum_over_time(metric[3002ms])
  {} 3002

eval instant at 4s sum_over_time(metric[3003ms])
  {} 3003

# Test integral
clear
load 10s
  metricbignum 0 1 1e100 1 -1e100 1 0
  metricinf 1 Inf 1 -Inf 1
  http_requests_total{app="ok", status="200"} 0+100x10000
  http_requests_total{app="ok", status="500"}   0+0x10000
  http_requests_total{app="justok", status="200"} 0+99.01x100 9901+100x9900
  http_requests_total{app="justok", status="500"}  0+0.99x100     99+0x9900
  http_requests_total{app="ko", status="200"} 0+99x100 9900+100x9900
  http_requests_total{app="ko", status="500"}  0+1x100    100+0x9900
  metricoscillator 0 1 2 1 0 -1 -2 -1 0
  metricnan1 NaN NaN 1 NaN NaN NaN
  metricnan2 NaN NaN 1 NaN NaN 2 NaN NaN NaN NaN NaN NaN NaN

# mid-point
eval instant at 1m integral(metricbignum[2m])
  {} 30

# mid-point fallback after warning
eval_warn instant at 1m integral(metricbignum[2m], 3)
  {} 30

# left-point
eval instant at 1m integral(metricbignum[2m], 0)
  {} 30

# right-point
eval instant at 1m integral(metricbignum[2m], 1)
  {} 30

eval instant at 1m integral(metricinf[2m])
  {} NaN

## SLA and integral()
## Note that we evaluate at 10010s (i.e. one step beyond the 10000s range) to ensure rate() has stabilized for the interval
#
# app="ok" has no 500s at all
eval instant at 10010s integral(((sum by (app) (rate(http_requests_total{app="ok", status="500"}[11s])) / sum by (app) (rate(http_requests_total{app="ok"}[11s]))) < bool 0.01)[10010s:10s], 1) / 10000 * 100
  {app="ok"} 100.00

# app="justok" has 1/10th period of 500s just there below 1%
eval instant at 10010s integral(((sum by (app) (rate(http_requests_total{app="justok", status="500"}[11s])) / sum by (app) (rate(http_requests_total{app="justok"}[11s]))) < bool 0.01)[10010s:10s], 1) / 10000 * 100
  {app="justok"} 100.00

# app="ko" has 1/10th period of 500s above 1%
eval instant at 10010s integral(((sum by (app) (rate(http_requests_total{app="ko", status="500"}[11s])) / sum by (app) (rate(http_requests_total{app="ko"}[11s]))) < bool 0.01)[10010s:10s], 1) / 10000 * 100
  {app="ko"} 90.00

## Simple discrete zero-up-zero-down-zero oscillator
# mid-point
eval instant at 2m integral(metricoscillator[2m1s])
  {} 0

# left-point
eval instant at 2m integral(metricoscillator[2m1s], 0)
  {} 0

# right-point
eval instant at 2m integral(metricoscillator[2m1s], 1)
  {} 0

