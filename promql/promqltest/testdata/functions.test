eval instant at 10s integral(metricnan1[10s])
  {} 0

eval instant at 20s integral(metricnan1[20s])
  {} 5

eval instant at 30s integral(metricnan1[30s])
  {} 10

# left-point
eval instant at 10s integral(metricnan1[10s], 0)
  {} 0

eval instant at 20s integral(metricnan1[20s], 0)
  {} 0

eval instant at 30s integral(metricnan1[30s], 0)
  {} 10

# right-point
eval instant at 10s integral(metricnan1[10s], 1)
  {} 0

eval instant at 20s integral(metricnan1[20s], 1)
  {} 10

eval instant at 30s integral(metricnan1[30s], 1)
  {} 10

## Integral test for couple non-NaN points
# mid-point
eval instant at 50s integral(metricnan2[50s])
  {} 20

eval instant at 60s integral(metricnan2[60s])
  {} 30

eval instant at 60s integral(metricnan2[60s])
  {} 30

# left-point
eval instant at 50s integral(metricnan2[50s], 0)
  {} 10

eval instant at 60s integral(metricnan2[60s], 0)
  {} 30

eval instant at 60s integral(metricnan2[60s], 0)
  {} 30

# right-point
eval instant at 50s integral(metricnan2[50s], 1)
  {} 30

eval instant at 60s integral(metricnan2[60s], 1)
  {} 30

eval instant at 60s integral(metricnan2[60s], 1)
  {} 30

## Below two integral tests must give same result for mid-point, left-point, and right-point
# - integral over 2m range
# - same integral over 2m (whole) range, slotted with sum_over_time() each 10s
#
# 1) mid-point
eval instant at 2m integral(metricnan2[2m])
  {} 30

eval instant at 2m sum_over_time(integral(metricnan2[11s])[2m:10s])
  {} 30

# 2) left-point
eval instant at 2m integral(metricnan2[2m], 0)
  {} 30

eval instant at 2m sum_over_time(integral(metricnan2[11s], 0)[2m:10s])
  {} 30

# 3) right-point
eval instant at 2m integral(metricnan2[2m], 1)
  {} 30

eval instant at 2m sum_over_time(integral(metricnan2[11s], 1)[2m:10s])
  {} 30

# Verify: \int_{0}^{1} (3x^2 - 30x + 14) \, dx = 0
# 0~ish with 0.005 tolerance, can't further increase resolution as you'd get too many samples error
eval instant at 1s round(integral(vector(3 * time()^2 - 30 * time() + 14)[1050ms:50ms]), 0.005)
  {} 0

# integral of sin(x), should be 0 (with a 1e-13 tolerance)
# mid-point
eval instant at 1m round(integral(sin(vector(time()/60*2*pi()))[60200ms:200ms]), 1e-14)
  {} 0

# left-point
eval instant at 1m round(integral(sin(vector(time()/60*2*pi()))[60200ms:200ms], 0), 1e-14)
  {} 0

# right-point
eval instant at 1m round(integral(sin(vector(time()/60*2*pi()))[60200ms:200ms], 1), 1e-14)
  {} 0

# "running" integral eval range of sin(x), period at 1m
# mid-point
eval range from 1m to 2m step 10s round(integral(sin(vector(time()/60*2*pi()))[60200ms:200ms]), 1e-14)
  {} 0+0x6

# left-point
eval range from 1m to 2m step 10s round(integral(sin(vector(time()/60*2*pi()))[60200ms:200ms], 0), 1e-14)
  {} 0+0x6

# right-point
eval range from 1m to 2m step 10s round(integral(sin(vector(time()/60*2*pi()))[60200ms:200ms], 1), 1e-14)
  {} 0+0x6

# "running" integral eval range of cos(x), period at 1m
# mid-point
eval range from 1m to 2m step 10s round(integral(cos(vector(time()/60*2*pi()))[60200ms:200ms]), 1e-14)
  {} 0+0x6

# left-point
eval range from 1m to 2m step 10s round(integral(cos(vector(time()/60*2*pi()))[60200ms:200ms], 0), 1e-14)
  {} 0+0x6

# right-point
eval range from 1m to 2m step 10s round(integral(cos(vector(time()/60*2*pi()))[60200ms:200ms], 1), 1e-14)
  {} 0+0x6

